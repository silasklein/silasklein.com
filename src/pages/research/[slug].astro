---
import ProjectPage from '../../components/pages/ProjectPage.astro';
import { projects } from '../../data/content';
export function getStaticPaths() { return projects.filter((p) => p.slug).map((p) => ({ params: { slug: p.slug }, props: { project: p } })); }
---
<ProjectPage lang="pt" project={Astro.props.project} />
