---
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Px from '../components/Pixel.astro';
import { ui, sections, profiles, email, t, langs, langInfo, type Lang } from '../data/content';
import { href, langPath, sig, asset, sitePath, BASE } from '../lib/format';

interface Props { lang: Lang; title?: string; description?: string; home?: boolean; noindex?: boolean; alternates?: Partial<Record<Lang, string>>; translated?: boolean; image?: string; imageWide?: boolean }
const { lang, title, description, home = false, noindex = false, image, imageWide = false } = Astro.props;
// Search results show about 65 characters of a title: long page titles drop the name suffix.
const pageTitle = title ? (title.length + 14 > 65 ? title : `${title} · Silas Klein`) : `Silas Klein · ${t(ui.descriptor, lang)}`;
// …and about 155 of a description: keep the whole sentences that fit, otherwise cut at a word.
const clip = (s: string, max = 155) => {
  s = s.replace(/\*/g, '').replace(/\s+/g, ' ').trim();
  if (s.length <= max) return s;
  let out = '';
  for (const x of s.match(/[^.!?]+[.!?]+(?=\s|$)/g) ?? []) { if ((out + x).trim().length > max) break; out += x; }
  out = out.trim();
  if (out.length >= 70) return out;
  const cut = s.slice(0, max - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:–—-]+$/, '') + '…';
};
const desc = clip(description ?? t(ui.subtitle, lang));
// The same page in each language, unless the page names other targets (e.g. a post without translation);
// a language without this page leads to its home.
const translated = Astro.props.translated ?? true;
const paths = Object.fromEntries(langs.map((l) => [l.code, Astro.props.alternates?.[l.code] ?? (translated ? langPath(Astro.url.pathname, l.code) : href('/', l.code))])) as Record<Lang, string>;
paths[lang] = BASE + sitePath(Astro.url.pathname);
const here = langInfo(lang);
const navKeys = ['about', 'research', 'publications', 'teaching', 'initiatives', 'design'] as const;
const canonical = new URL(sitePath(Astro.url.pathname), Astro.site);
const portrait = new URL('/img/og-portrait.jpg', Astro.site);
// Pages with their own picture (cases, posts) share it; the rest share the portrait.
const ogImage = image ? new URL(image, Astro.site) : portrait;
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://www.silasklein.com/#person',
  name: 'Silas Klein', alternateName: 'Silas Klein Cardoso', url: 'https://www.silasklein.com/', image: portrait.href,
  jobTitle: t({ pt: 'Professor de Antigo Testamento e Ciências das Religiões', en: 'Professor of Old Testament and Religious Studies', es: 'Profesor de Antiguo Testamento y Ciencias de las Religiones' }, lang),
  description: t(ui.subtitle, lang),
  worksFor: { '@type': 'CollegeOrUniversity', name: 'Faculdade Unida de Vitória', url: 'https://fuv.edu.br/' },
  affiliation: [{ '@type': 'CollegeOrUniversity', name: 'University of Bern', url: 'https://www.unibe.ch/' }],
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universidade Metodista de São Paulo' }],
  award: ['Grande Prêmio CAPES de Tese Bertha Koiffmann Becker (2020)', 'Prêmio CAPES de Tese (2020)'],
  knowsAbout: ['Iconography', 'Stamp seals', 'History of religion', 'Ancient southern Levant', 'Hebrew Bible', 'Visual culture', 'Digital humanities'],
  sameAs: [...profiles.map((p) => p.href), 'https://universosbiblicos.org'],
};
---
<!doctype html>
<html lang={here.hreflang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'${import.meta.env.DEV ? ' ws:' : ''}; object-src 'none'; base-uri 'self'; form-action 'none'`} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {(BASE || noindex) && <meta name="robots" content="noindex" />}
  {!noindex && translated && <>
    {langs.map((l) => <link rel="alternate" hreflang={l.hreflang} href={new URL(sitePath(paths[l.code]), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(sitePath(paths.pt), Astro.site)} />
  </>}
  <link rel="sitemap" href={asset('/sitemap.xml')} />
  <link rel="icon" type="image/png" sizes="19x19" href={asset('/favicon-19.png')} />
  <link rel="icon" type="image/png" sizes="38x38" href={asset('/favicon-38.png')} />
  <link rel="icon" type="image/png" sizes="76x76" href={asset('/favicon-76.png')} />
  <link rel="apple-touch-icon" sizes="190x190" href={asset('/favicon-190.png')} />
  <meta property="og:type" content={home ? 'profile' : 'article'} />
  <meta property="og:site_name" content="Silas Klein" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={here.locale} />
  {langs.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.locale} />)}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={ogImage} />
  {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="1200" /></>}
  <meta property="og:image:alt" content={image ? (title ?? 'Silas Klein') : 'Silas Klein'} />
  <meta name="twitter:card" content={imageWide ? 'summary_large_image' : 'summary'} />
  <meta name="author" content="Silas Klein" />
  <meta name="theme-color" content="#F5F6F4" />
  {home && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  <slot name="head" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip" href="#main">{t({ pt: 'Pular para o conteúdo', en: 'Skip to content', es: 'Saltar al contenido' }, lang)}</a>
  <header class="topbar">
    <a class="topbar__logo" href={href('/', lang)} aria-label={t(ui.back, lang)}>
      <Logo scale={1.5} />
    </a>
    <nav class="topbar__nav" aria-label="Main">
      <ul>
        {navKeys.map((k) => (
          <li><a href={href(`#${k}`, lang)} data-nav={k}>{t(ui.nav[k], lang)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="topbar__end">
      <details class="langs">
        <summary class="topbar__lang" aria-label={t(ui.language, lang)}><Px name="translate" /><span aria-hidden="true">{here.short}</span></summary>
        <ul class="langs__list">
          {langs.map((l) => (
            <li><a href={paths[l.code]} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === lang ? 'true' : undefined}><span>{l.name}</span><small>{l.short}</small></a></li>
          ))}
        </ul>
      </details>
      <a class="topbar__contact" href={href('#contact', lang)} data-nav="contact"><Px name="mail" />{t(ui.nav.contact, lang)}</a>
      <button class="topbar__menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr">Menu</span><span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </header>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      {navKeys.map((k) => (<li><a href={href(`#${k}`, lang)}>{t(ui.nav[k], lang)}</a></li>))}
      <li><a href={href('#contact', lang)}>{t(ui.nav.contact, lang)}</a></li>
    </ul>
    <div class="mlangs">
      <p class="mlangs__k" id="mlangs-k"><Px name="translate" />{t(ui.language, lang)}</p>
      <ul aria-labelledby="mlangs-k">{langs.map((l) => (<li><a href={paths[l.code]} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a></li>))}</ul>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <div>
        <Logo scale={1} />
        <p class="footer__descriptor" set:html={sig(t(ui.descriptor, lang))} />
      </div>
      <ul class="footer__profiles">
        <li><a class="fl" href={`mailto:${email}`}><Px name="mail" /><span class="fl__t">{email}</span></a></li>
        {profiles.map((p) => (<li><a class="fl" href={p.href} rel="me noopener" target="_blank"><Px name={p.icon} /><span class="fl__t">{p.name}</span></a></li>))}
        <li><a class="fl" href="https://universosbiblicos.org" rel="noopener" target="_blank"><Px name="oub" /><span class="fl__t">Observatório</span></a></li>
      </ul>
      <p class="footer__legal">© {new Date().getFullYear()} Silas Klein. {t(ui.rights, lang)}</p>
    </div>
  </footer>

  <script src="../scripts/motion.ts"></script>
</body>
</html>
