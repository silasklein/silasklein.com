---
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Px from '../components/Pixel.astro';
import { ui, sections, profiles, email, t, type Lang } from '../data/content';
import { href, switchPath, sig } from '../lib/format';

interface Props { lang: Lang; title?: string; description?: string; home?: boolean }
const { lang, title, description, home = false } = Astro.props;
const pageTitle = title ? `${title} · Silas Klein` : `Silas Klein · ${ui.descriptor}`;
const desc = description ?? t(ui.subtitle, lang);
const other = switchPath(Astro.url.pathname, lang);
const navKeys = ['about', 'research', 'publications', 'teaching', 'initiatives', 'design'] as const;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'${import.meta.env.DEV ? ' ws:' : ''}; object-src 'none'; base-uri 'self'; form-action 'none'`} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang === 'pt' ? 'en' : 'pt-BR'} href={new URL(other, Astro.site)} />
  <link rel="icon" type="image/png" sizes="19x19" href="/favicon-19.png" />
  <link rel="icon" type="image/png" sizes="38x38" href="/favicon-38.png" />
  <link rel="icon" type="image/png" sizes="76x76" href="/favicon-76.png" />
  <link rel="apple-touch-icon" sizes="190x190" href="/favicon-190.png" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={new URL('/img/portrait-scholar.webp', Astro.site)} />
  <meta name="theme-color" content="#F5F6F4" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Silas Klein Cardoso', url: 'https://www.silasklein.com',
    jobTitle: 'Professor of Old Testament and Religious Studies',
    affiliation: [{ '@type': 'CollegeOrUniversity', name: 'Faculdade Unida de Vitória' }, { '@type': 'CollegeOrUniversity', name: 'University of Bern' }],
    sameAs: profiles.map((p) => p.href),
  })} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip" href="#main">{lang === 'pt' ? 'Pular para o conteúdo' : 'Skip to content'}</a>
  <header class="topbar">
    <a class="topbar__logo" href={href('/', lang)} aria-label={t(ui.back, lang)}>
      <Logo scale={2} />
    </a>
    <nav class="topbar__nav" aria-label="Main">
      <ul>
        {navKeys.map((k) => (
          <li><a href={href(`#${k}`, lang)} data-nav={k}>{t(ui.nav[k], lang)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="topbar__end">
      <a class="topbar__lang" href={other} hreflang={lang === 'pt' ? 'en' : 'pt-BR'} lang={lang === 'pt' ? 'en' : 'pt-BR'}>
        {lang === 'pt' ? 'EN' : 'PT'}<span class="sr">{t(ui.langName, lang)}</span>
      </a>
      <a class="topbar__contact" href={href('#contact', lang)} data-nav="contact"><Px name="mail" />{t(ui.nav.contact, lang)}</a>
      <button class="topbar__menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr">Menu</span><span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </header>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      {navKeys.map((k) => (<li><a href={href(`#${k}`, lang)}>{t(ui.nav[k], lang)}</a></li>))}
      <li><a href={href('#contact', lang)}>{t(ui.nav.contact, lang)}</a></li>
      <li><a href={other}>{t(ui.langName, lang)}</a></li>
    </ul>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <div>
        <Logo scale={1} />
        <p class="footer__descriptor" set:html={sig(ui.descriptor)} />
      </div>
      <ul class="footer__profiles">
        <li><a class="fl" href={`mailto:${email}`}><Px name="mail" /><span class="fl__t">{email}</span></a></li>
        {profiles.map((p) => (<li><a class="fl" href={p.href} rel="me noopener" target="_blank"><Px name={p.icon} /><span class="fl__t">{p.name}</span></a></li>))}
      </ul>
      <p class="footer__legal">© {new Date().getFullYear()} Silas Klein Cardoso. {t(ui.rights, lang)}</p>
    </div>
  </footer>

  <script src="../scripts/motion.ts"></script>
</body>
</html>
