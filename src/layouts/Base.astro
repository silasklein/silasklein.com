---
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Px from '../components/Pixel.astro';
import { ui, sections, profiles, email, t, type Lang } from '../data/content';
import { href, switchPath, sig, asset, sitePath, BASE } from '../lib/format';

interface Props { lang: Lang; title?: string; description?: string; home?: boolean; noindex?: boolean; other?: string; translated?: boolean }
const { lang, title, description, home = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · Silas Klein` : `Silas Klein · ${t(ui.descriptor, lang)}`;
const desc = description ?? t(ui.subtitle, lang);
// The language switch: same page in the other language, unless the page names another target (e.g. a post without translation).
const other = Astro.props.other ?? switchPath(Astro.url.pathname, lang);
const translated = Astro.props.translated ?? true;
const navKeys = ['about', 'research', 'publications', 'teaching', 'initiatives', 'design'] as const;
const canonical = new URL(sitePath(Astro.url.pathname), Astro.site);
// Language versions of this page: Portuguese is the default (x-default), English lives under /en/.
const ptPath = lang === 'pt' ? sitePath(Astro.url.pathname) : sitePath(other);
const enPath = lang === 'en' ? sitePath(Astro.url.pathname) : sitePath(other);
const ogImage = new URL('/img/og-portrait.jpg', Astro.site);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://www.silasklein.com/#person',
  name: 'Silas Klein', alternateName: 'Silas Klein Cardoso', url: 'https://www.silasklein.com/', image: ogImage.href,
  jobTitle: lang === 'pt' ? 'Professor de Antigo Testamento e Ciências das Religiões' : 'Professor of Old Testament and Religious Studies',
  description: t(ui.subtitle, lang),
  worksFor: { '@type': 'CollegeOrUniversity', name: 'Faculdade Unida de Vitória', url: 'https://fuv.edu.br/' },
  affiliation: [{ '@type': 'CollegeOrUniversity', name: 'University of Bern', url: 'https://www.unibe.ch/' }],
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universidade Metodista de São Paulo' }],
  award: ['Grande Prêmio CAPES de Tese Bertha Koiffmann Becker (2020)', 'Prêmio CAPES de Tese (2020)'],
  knowsAbout: ['Iconography', 'Stamp seals', 'History of religion', 'Ancient southern Levant', 'Hebrew Bible', 'Visual culture', 'Digital humanities'],
  sameAs: [...profiles.map((p) => p.href), 'https://universosbiblicos.org'],
};
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'${import.meta.env.DEV ? ' ws:' : ''}; object-src 'none'; base-uri 'self'; form-action 'none'`} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {(BASE || noindex) && <meta name="robots" content="noindex" />}
  {!noindex && translated && <>
    <link rel="alternate" hreflang="pt-BR" href={new URL(ptPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(ptPath, Astro.site)} />
  </>}
  <link rel="sitemap" href={asset('/sitemap.xml')} />
  <link rel="icon" type="image/png" sizes="19x19" href={asset('/favicon-19.png')} />
  <link rel="icon" type="image/png" sizes="38x38" href={asset('/favicon-38.png')} />
  <link rel="icon" type="image/png" sizes="76x76" href={asset('/favicon-76.png')} />
  <link rel="apple-touch-icon" sizes="190x190" href={asset('/favicon-190.png')} />
  <meta property="og:type" content={home ? 'profile' : 'article'} />
  <meta property="og:site_name" content="Silas Klein" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:alt" content="Silas Klein" />
  <meta name="twitter:card" content="summary" />
  <meta name="author" content="Silas Klein" />
  <meta name="theme-color" content="#F5F6F4" />
  {home && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  <slot name="head" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip" href="#main">{lang === 'pt' ? 'Pular para o conteúdo' : 'Skip to content'}</a>
  <header class="topbar">
    <a class="topbar__logo" href={href('/', lang)} aria-label={t(ui.back, lang)}>
      <Logo scale={1.5} />
    </a>
    <nav class="topbar__nav" aria-label="Main">
      <ul>
        {navKeys.map((k) => (
          <li><a href={href(`#${k}`, lang)} data-nav={k}>{t(ui.nav[k], lang)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="topbar__end">
      <a class="topbar__lang" href={other} hreflang={lang === 'pt' ? 'en' : 'pt-BR'} lang={lang === 'pt' ? 'en' : 'pt-BR'}>
        {lang === 'pt' ? 'EN' : 'BR'}<span class="sr">{t(ui.langName, lang)}</span>
      </a>
      <a class="topbar__contact" href={href('#contact', lang)} data-nav="contact"><Px name="mail" />{t(ui.nav.contact, lang)}</a>
      <button class="topbar__menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr">Menu</span><span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </header>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      {navKeys.map((k) => (<li><a href={href(`#${k}`, lang)}>{t(ui.nav[k], lang)}</a></li>))}
      <li><a href={href('#contact', lang)}>{t(ui.nav.contact, lang)}</a></li>
      <li><a href={other}>{t(ui.langName, lang)}</a></li>
    </ul>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <div>
        <Logo scale={1} />
        <p class="footer__descriptor" set:html={sig(t(ui.descriptor, lang))} />
      </div>
      <ul class="footer__profiles">
        <li><a class="fl" href={`mailto:${email}`}><Px name="mail" /><span class="fl__t">{email}</span></a></li>
        {profiles.map((p) => (<li><a class="fl" href={p.href} rel="me noopener" target="_blank"><Px name={p.icon} /><span class="fl__t">{p.name}</span></a></li>))}
        <li><a class="fl" href="https://universosbiblicos.org" rel="noopener" target="_blank"><Px name="oub" /><span class="fl__t">Observatório</span></a></li>
      </ul>
      <p class="footer__legal">© {new Date().getFullYear()} Silas Klein. {t(ui.rights, lang)}</p>
    </div>
  </footer>

  <script src="../scripts/motion.ts"></script>
</body>
</html>
