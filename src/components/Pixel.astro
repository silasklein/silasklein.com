---
// Pixel icons from pixelarticons (MIT). Their pixels are 2 units wide on a 24-unit viewBox, but many icons sit
// on odd coordinates; the viewBox is shifted per axis so every icon pixel starts on the grid. Rendered at
// 18 px (1.5 CSS px per icon pixel = 3 device pixels on Retina screens) by default.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { MAP, CUSTOM } from '../lib/icons';


// Whether the icon's x / y coordinates are odd (then the viewBox moves by one unit on that axis).
function parity(d: string): [number, number] {
  const tok = d.match(/[a-zA-Z]|-?\d*\.?\d+/g) ?? [];
  let x = 0, y = 0, sx = 0, sy = 0, cmd = '', i = 0, ox = 0, oy = 0;
  const num = () => parseFloat(tok[i++]);
  while (i < tok.length) {
    if (/[a-zA-Z]/.test(tok[i])) cmd = tok[i++];
    const rel = cmd === cmd.toLowerCase();
    switch (cmd.toUpperCase()) {
      case 'M': case 'L': { const a = num(), b = num(); x = rel ? x + a : a; y = rel ? y + b : b; if (cmd.toUpperCase() === 'M') { sx = x; sy = y; cmd = rel ? 'l' : 'L'; } break; }
      case 'H': { const a = num(); x = rel ? x + a : a; break; }
      case 'V': { const b = num(); y = rel ? y + b : b; break; }
      case 'Z': x = sx; y = sy; continue;
      default: i++; continue;
    }
    if (Math.abs(x % 2) === 1) ox++; else ox--;
    if (Math.abs(y % 2) === 1) oy++; else oy--;
  }
  return [ox > 0 ? 1 : 0, oy > 0 ? 1 : 0];
}

// Resolved from the project root: the bundled component no longer sits next to node_modules at build time.
const dir = join(process.cwd(), 'node_modules/pixelarticons/svg/');
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 18, class: cls = '', label } = Astro.props;
const file = MAP[name] ?? name;
let inner = '';
if (CUSTOM[name]) inner = `<path d="${CUSTOM[name]}"/>`;
else try {
  inner = readFileSync(`${dir}${file}.svg`, 'utf8').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
} catch { inner = ''; }
const d = [...inner.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]).join(' ');
const [ox, oy] = parity(d);
---
<svg class:list={['px', cls]} viewBox={`${ox} ${oy} 24 24`} width={size} height={size} fill="currentColor" shape-rendering="crispEdges" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false" set:html={inner} />
