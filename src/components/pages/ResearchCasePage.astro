---
// Design-for-research case: thesis → evidence → skills. Each decision sits beside the images that prove it;
// the page ends with its skill tags and three cases that share one (CaseEnd).
import sharp from 'sharp';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import Px from '../Pixel.astro';
import CaseEnd from '../CaseEnd.astro';
import Rich from '../Rich.astro';
import { researchCases, sections, t, type Lang, type ResearchCase } from '../../data/content';
import { href, asset } from '../../lib/format';
interface Props { lang: Lang; item: ResearchCase }
const { lang, item: c } = Astro.props;
const pt = lang === 'pt';
const division = pt ? 'Design para a pesquisa' : 'Design for research';

// Width and height of every image, read from the file so the layout never jumps.
const size = new Map<string, { width: number; height: number }>();
for (const src of [c.hero, ...c.decisions.flatMap((d) => (d.images ?? []).map((i) => i.src))]) {
  const m = await sharp(join(process.cwd(), 'public', src)).metadata();
  size.set(src, { width: m.width!, height: m.height! });
}

// Captions: the first sentence in bold.
const cap = (s: string) => { const m = s.match(/^(.+?[.!?])(\s|$)(.*)$/s); return m ? { b: m[1], rest: m[3] } : { b: '', rest: s }; };

const context = c.context ? t(c.context, lang) : '';
const problem = c.problem ? t(c.problem, lang) : '';

const i = researchCases.findIndex((x) => x.slug === c.slug);
const prev = researchCases[(i - 1 + researchCases.length) % researchCases.length];
const next = researchCases[(i + 1) % researchCases.length];
---
<Base lang={lang} title={c.title} description={t(c.lead, lang).replace(/\*/g, '')}>
  <article class="cs">
    <div class="wrap cs__top">
      <a class="act cs__back" href={href('#design', lang)}><Px name="arrowRight" class="flip" /><span>Design</span></a>
      <Label n={sections.design.n} text={division} />
      <h1>{c.title}</h1>
      <p class="cs__thesis"><span class="bs" aria-hidden="true">\</span>{t(c.thesis, lang)}</p>
      <div class="cs__head">
        <p class="cs__lead"><Rich text={t(c.lead, lang)} /></p>
        <dl class="cs__meta">{c.meta.map((m) => (<><dt>{t(m.k, lang)}</dt><dd>{t(m.v, lang)}</dd></>))}</dl>
      </div>
      <div class="cs__gal cs__hero">
        <figure style="--span:12"><img src={asset(c.hero)} alt={c.hero_alt ? t(c.hero_alt, lang) : ''} {...size.get(c.hero)} loading="eager" decoding="async" /></figure>
      </div>
      {(context || problem) && (
        <div class:list={['cs__cp', { 'cs__cp--cols': context && !problem && context.length > 450 }]}>
          {context && <div class="cs__cpc"><span class="cs__cpk">{pt ? 'Contexto' : 'Context'}</span><p><Rich text={context} /></p></div>}
          {problem && <div class="cs__cpc"><span class="cs__cpk">{c.problem_label && t(c.problem_label, lang) ? t(c.problem_label, lang) : pt ? 'Problema' : 'Problem'}</span><p><Rich text={problem} /></p></div>}
        </div>
      )}
      <h2 class="cs__h">{pt ? 'O que fiz' : 'What I did'}</h2>
      <div class="cs__decs">
        {c.decisions.map((d) => {
          const imgs = d.images ?? [];
          const kind = d.wide ? ' cs__dec--wide' : imgs.length ? '' : ' cs__dec--plain';
          return (
            <div class={`cs__dec${kind}`}>
              <div class="cs__dtxt">
                <h3 class="cs__dt"><span class="bs" aria-hidden="true">\</span>{t(d.title, lang)}</h3>
                {d.wide || !imgs.length || !t(d.text, lang) ? null : <p><Rich text={t(d.text, lang)} /></p>}
                {d.figures?.length ? (
                  <div class="cs__dfigs">
                    {d.figures_intro && <span>{t(d.figures_intro, lang)}</span>}
                    <div class="cs__figs">{d.figures.map((f) => (<div><b>{f.n}</b><span>{t(f.label, lang)}</span></div>))}</div>
                  </div>
                ) : null}
              </div>
              {(d.wide || !imgs.length) && t(d.text, lang) && <p class="cs__dbody"><Rich text={t(d.text, lang)} /></p>}
              {imgs.length > 0 && (
                <div class="cs__gal">
                  {imgs.map((im) => {
                    const caption = im.caption ? t(im.caption, lang) : '';
                    const k = cap(caption);
                    const img = <img src={asset(im.src)} alt={caption} {...size.get(im.src)} loading="lazy" decoding="async" />;
                    return (
                      <figure style={`--span:${im.span ?? 12}`}>
                        {im.plate ? <div class="cs__plate">{img}</div> : img}
                        {caption && <figcaption>{k.b && <b>{k.b}</b>}{k.b && k.rest ? ' ' : ''}{k.rest}</figcaption>}
                      </figure>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <CaseEnd lang={lang} slug={c.slug} tags={c.tags} research={true}>
        <nav class="cs__pager" aria-label={pt ? `Outros cases de ${division}` : `Other ${division} cases`}>
          <a href={href(`/design/${prev.slug}`, lang)}><Px name="arrowRight" class="flip" /><span><small>{pt ? 'Anterior' : 'Previous'}</small>{prev.title}</span></a>
          <a href={href(`/design/${next.slug}`, lang)} class="cs__next"><span><small>{pt ? 'Próximo' : 'Next'}</small>{next.title}</span><Px name="arrowRight" /></a>
        </nav>
      </CaseEnd>
    </div>
  </article>
</Base>
