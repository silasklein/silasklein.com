---
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import { ui, news, sections, type Lang, t } from '../../data/content';
import Px from '../Pixel.astro';
import { href } from '../../lib/format';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base lang={lang} title={lang === 'pt' ? 'Notícias' : 'News'} description={lang === 'pt' ? 'Notícias de Silas Klein Cardoso: livros, projetos, eventos e escolas de verão sobre imagens, religião e o antigo Levante.' : 'News from Silas Klein Cardoso: books, projects, events and summer schools on images, religion and the ancient Levant.'}>
  <div class="page">
    <a class="page__back" href={href('#currently', lang)}>← {t(ui.back, lang)}</a>
    <Label n={sections.currently.n} text={t(sections.currently.label, lang)} />
    <h1 class="h2">{lang === 'pt' ? 'Notícias' : 'News'}</h1>
    <ul class="news-list">
      {news.map((p) => (
        <li>
          <time datetime={p.date}>{fmt(p.date)}</time>
          <div>
            <h2><a href={href(`/news/${p.slug}`, lang)}>{p.title}</a>{p.lang !== lang && <span class="tag">{p.lang.toUpperCase()}</span>}</h2>
            <p>{p.summary}</p>
            <a class="act news-list__more" href={href(`/news/${p.slug}`, lang)}><Px name="arrowRight" /><span>{lang === 'pt' ? 'Ler a notícia completa' : 'Read the full story'}</span></a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
