---
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import Px from '../Pixel.astro';
import { designForResearch, ui, t, type Lang, type DesignItem } from '../../data/content';
import { href } from '../../lib/format';
interface Props { lang: Lang; item: DesignItem }
const { lang, item: d } = Astro.props;
const pt = lang === 'pt';
const i = designForResearch.findIndex((x) => x.slug === d.slug);
const prev = designForResearch[(i - 1 + designForResearch.length) % designForResearch.length];
const next = designForResearch[(i + 1) % designForResearch.length];
---
<Base lang={lang} title={t(d.title, lang)} description={t(d.text, lang)}>
  <article class="page">
    <a class="act page__back" href={href('#design', lang)}><Px name="arrowRight" class="flip" /><span>{pt ? 'Design para a pesquisa' : 'Design for research'}</span></a>
    <Label n="07" text={pt ? 'design para a pesquisa' : 'design for research'} />
    <h1 class="h2"><Px name={d.icon} size={36} /> {t(d.title, lang)}</h1>
    <dl class="meta">
      <dt>{t(ui.year, lang)}</dt><dd>{d.year}</dd>
      <dt>{t(ui.role, lang)}</dt><dd>{t(d.role, lang)}</dd>
      <dt>{t(ui.commissioner, lang)}</dt><dd>{d.client}</dd>
    </dl>
    <div class="prose lead"><p>{t(d.body, lang)}</p></div>
    {d.href && <p class="page__link"><a class="act" href={d.href} target="_blank" rel="noopener"><Px name="arrowUpRight" /><span>{d.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span></a></p>}
    <nav class="pager">
      <a class="act" href={href(`/design-for-research/${prev.slug}`, lang)}><Px name="arrowRight" class="flip" /><span>{t(prev.title, lang)}</span></a>
      <a class="act" href={href(`/design-for-research/${next.slug}`, lang)}><span>{t(next.title, lang)}</span><Px name="arrowRight" /></a>
    </nav>
  </article>
</Base>
