---
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import { sections, t, type Lang, type Post } from '../../data/content';
import { href, BASE } from '../../lib/format';
interface Props { lang: Lang; post: Post }
const { lang, post: p } = Astro.props;
// Root-relative images in the post point to /img/…; on the preview address they need the prefix.
const body = p.html?.replace(/(src|href)="\/(?!\/)/g, `$1="${BASE}/`).replace(/<img /g, '<img loading="lazy" decoding="async" ');
const fmt = new Date(p.date + 'T12:00:00').toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base lang={lang} title={p.title} description={p.summary}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.title, description: p.summary,
    datePublished: p.date, inLanguage: p.lang === 'pt' ? 'pt-BR' : 'en',
    author: { '@id': 'https://www.silasklein.com/#person', '@type': 'Person', name: 'Silas Klein Cardoso' },
  })} />
  <article class="page" lang={p.lang === 'pt' ? 'pt-BR' : 'en'}>
    <a class="page__back" href={href('/news', lang)}>← {lang === 'pt' ? 'Notícias' : 'News'}</a>
    <Label n={sections.currently.n} text={t(sections.currently.label, lang)} />
    <p class="post__date"><time datetime={p.date}>{fmt}</time></p>
    <h1 class="h2">{p.title}</h1>
    {body
      ? <div class="prose post__body" set:html={body} />
      : <div class="prose lead"><p>{p.summary}</p></div>}
  </article>
</Base>
