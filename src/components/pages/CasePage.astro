---
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import { ui, cases, t, type Lang, type Case } from '../../data/content';
import { href } from '../../lib/format';
interface Props { lang: Lang; item: Case }
const { lang, item: c } = Astro.props;
const i = cases.findIndex((x) => x.slug === c.slug);
const prev = cases[(i - 1 + cases.length) % cases.length], next = cases[(i + 1) % cases.length];
---
<Base lang={lang} title={c.title} description={t(c.text, lang)}>
  <article class="page">
    <a class="page__back" href={href('/design', lang)}>← Design</a>
    <Label n="06" text={lang === 'pt' ? 'direção de arte' : 'art direction'} />
    <h1 class="h2">{c.title}</h1>
    <img class="case-img" src={c.image} alt={c.title} width="760" height="1013" />
    <p class="lead">{t(c.text, lang)}</p>
    <dl class="meta">
      <dt>{t(ui.role, lang)}</dt><dd>{c.role}</dd>
      {c.commissioner && <><dt>{t(ui.commissioner, lang)}</dt><dd>{c.commissioner}</dd></>}
      {c.year && <><dt>{t(ui.year, lang)}</dt><dd>{c.year}</dd></>}
    </dl>
    <nav class="pager">
      <a href={href(`/design/${prev.slug}`, lang)}>← {prev.title}</a>
      <a href={href(`/design/${next.slug}`, lang)}>{next.title} →</a>
    </nav>
  </article>
</Base>
