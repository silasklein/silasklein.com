---
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import RolePlace from '../RolePlace.astro';
import Rich from '../Rich.astro';
import { ui, projects, sections, t, type Lang, type Project } from '../../data/content';
import { sig, href, yrs } from '../../lib/format';
interface Props { lang: Lang; project: Project }
const { lang, project: p } = Astro.props;
const withPages = projects.filter((x) => x.slug);
const i = withPages.findIndex((x) => x.slug === p.slug);
const prev = withPages[i - 1], next = withPages[i + 1];
---
<Base lang={lang} title={t(p.title, lang).replace(/\\/g, '')} description={t(p.summary, lang)}>
  <article class="page">
    <a class="page__back" href={href('#research', lang)}>← {t(ui.nav.research, lang)}</a>
    <Label n={sections.research.n} text={t(sections.research.label, lang)} />
    <h1 class="h2" set:html={sig(t(p.title, lang))} />
    <dl class="meta">
      <dt>{lang === 'pt' ? 'Período' : 'Period'}</dt><dd>{yrs(p.years, lang)}</dd>
      <dt>{t(ui.role, lang)}</dt><dd><RolePlace project={p} lang={lang} /></dd>
      {p.funding && <><dt>{t(ui.funding, lang)}</dt><dd>{p.funding}</dd></>}
      {p.team && <><dt>{t(ui.team, lang)}</dt><dd>{t(p.team, lang)}</dd></>}
      {p.partners && <><dt>{t(ui.partners, lang)}</dt><dd>{p.partners}</dd></>}
    </dl>
    <div class="prose lead"><p><Rich text={t(p.summary, lang)} /></p></div>
    {p.outputs && <ul class="outputs">{p.outputs.map((o) => <li>{t(o, lang)}</li>)}</ul>}
    <nav class="pager">
      {prev ? <a href={href(`/research/${prev.slug}`, lang)} set:html={'← ' + sig(t(prev.title, lang))} /> : <span />}
      {next ? <a href={href(`/research/${next.slug}`, lang)} set:html={sig(t(next.title, lang)) + ' →'} /> : <span />}
    </nav>
  </article>
</Base>
