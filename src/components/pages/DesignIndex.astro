---
import Base from '../../layouts/Base.astro';
import Label from '../Label.astro';
import { ui, sections, designIntro, designForResearch, agencies, brands, cases, t, type Lang } from '../../data/content';
import { sig, href, asset } from '../../lib/format';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} title={t(sections.design.title, lang)} description={t(designIntro, lang)}>
  <div class="page">
    <a class="page__back" href={href('#design', lang)}>← {t(ui.back, lang)}</a>
    <Label n="06" text={t(sections.design.label, lang)} />
    <h1 class="h2" set:html={sig(t(sections.design.title, lang))} />
    <p class="lead">{t(designIntro, lang)}</p>
    <ul class="list list--3">
      {designForResearch.map((d) => (<li><h2 class="card__title">{t(d.title, lang)}</h2><p>{t(d.text, lang)}</p></li>))}
    </ul>
    <h2 class="sub"><span>b</span> {lang === 'pt' ? 'direção de arte, 2002–' : 'art direction, 2002–'}</h2>
    <p class="lead">{agencies}<br />{brands}</p>
    <div class="grid-all">
      {cases.map((c) => (
        <a class="tile" href={href(`/design/${c.slug}`, lang)}>
          <img src={asset(c.image)} alt="" width="600" height="800" loading="lazy" />
          <span class="tile__t">{c.title}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
